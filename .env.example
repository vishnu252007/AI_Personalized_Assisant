# ==============================================================================
# LearnAI — Environment Variables Configuration Matrix
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Required)
# Source: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Application URL (Required for OAuth redirects)
# Localhost: http://localhost:3000
# Production: https://your-production-domain.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Gemini AI (Required)
# Source: Google AI Studio (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Upstash Redis Rate Limiting (Optional - Falls back to in-memory token bucket)
# Source: Upstash Console (https://console.upstash.com)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Groq Fallback AI (Optional - Falls back to Gemini-only execution)
# Source: Groq Console (https://console.groq.com/keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
